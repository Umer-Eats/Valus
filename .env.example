# Server-only. Copy to .env and fill in; never commit .env.
# Set the same values in Vercel > Project > Settings > Environment Variables.

# Hal chat (Gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional FRQ grading model override; falls back to GEMINI_MODEL.
GEMINI_GRADING_MODEL=

# Turso. Leave TURSO_DATABASE_URL unset locally to use a file database in .data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Firebase Admin (server-side token verification). Firebase console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n between lines.
FIREBASE_PRIVATE_KEY=

# Firebase web config (public, served to the browser by GET /api/config).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Firebase Storage bucket for ranked skill and online submission uploads (e.g. your-project.firebasestorage.app).
# Enable Storage in the Firebase console and publish storage.rules from this repo.
FIREBASE_STORAGE_BUCKET=

# Community passwords. The setting names come from communities.json.
# Student and instructor passwords must differ, and no two communities may share a student password.
PPCHS_STUDENT_PASSWORD=
PPCHS_INSTRUCTOR_PASSWORD=
